{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Random Tube",
  "mainBinaryName": "Random Tube",
  "version": "1.1.0",
  "identifier": "com.randomseasons.randomtube",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Random Tube",
        "width": 1360,
        "height": 840,
        "minWidth": 420,
        "minHeight": 400,
        "maximized": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
